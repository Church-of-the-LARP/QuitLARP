# ---------------------------------------------------------------------------
# QuitLARP backend configuration — copy this file to .env and fill it in:
#
#     cp backend/.env.example backend/.env
#
# .env is git-ignored. Everything below is read from the environment at
# startup; docker compose additionally overrides DATABASE_URL for the
# container network. No secret is hard-coded anywhere in the code.
# ---------------------------------------------------------------------------

# Postgres DSN. Inside docker compose this value is overridden with the
# in-network URL; use the one below when running `go run .` on the host
# against a local postgres.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# development | production (production flips cookie Secure on unless
# COOKIE_SECURE is set explicitly)
ENV=development

# Where the backend listens.
PORT=8888

# ---------------------------------------------------------------------------
# Auth secrets — generate with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=<generate-with-openssl-rand-hex-32>

# How long a login session stays valid.
SESSION_TTL_HOURS=24

# How long email verification / password reset links stay valid.
ACTION_TOKEN_TTL_HOURS=24

# Set to true when the site is served over https (defaults to ENV=production).
# COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Google OAuth ("Sign in with Google")
# ---------------------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client IDs -> Web application). Add the Redirect URI below
# (GOOGLE_REDIRECT_URL) as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty to derive from PUBLIC_BASE_URL automatically.
GOOGLE_REDIRECT_URL=

# Externally reachable URL of THIS backend (used for links inside emails).
PUBLIC_BASE_URL=http://localhost:8888

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
# Where the React app runs (redirect target after Google sign-in, base of
# reset-password links in emails).
FRONTEND_URL=http://localhost:5173

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Superadmin (the single bootstrap super admin for the app)
# ---------------------------------------------------------------------------
# On first boot the backend creates this account with role "superadmin",
# email_verified=true, using SUPERADMIN_PASSWORD. Only this account can
# change roles, and the role of this account can never be demoted.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=<choose-a-strong-password>

# Display name used by the (mock) email sender.
EMAIL_FROM=QuitLARP <no-reply@example.com>
