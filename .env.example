# QuitLARP environment — copy this file to .env at the repository root.
#
#     cp .env.example .env
#
# This is the only env file the project reads. Compose loads it automatically
# for local runs; Launchpad asks for the same values once per compose project.
# There is no backend/.env anymore.
#
# Behind Launchpad/Traefik/Cloudflare, use the public HTTPS origins:
#   PUBLIC_BASE_URL=https://api.example.com
#   FRONTEND_URL=https://app.example.com
#   CORS_ORIGINS=https://app.example.com
#   VITE_API_URL=https://api.example.com
# Launchpad owns the Cloudflare tunnel and the external `web` network, so no
# TUNNEL_TOKEN or cloudflared service is needed in this stack.

# --- Compose -----------------------------------------------------------------

# Host ports for local runs. Launchpad removes published host ports and uses
# the container ports instead.
BACKEND_PORT=8888
FRONTEND_PORT=5173
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# UniversalTestingFramework source for the backend's `utf` build stage.
# The default in compose.yaml is a public Git URL, so fresh clones work.
# For a local sibling checkout override it, for example:
# UTF_SRC=../UniversalTestingFramework
# UTF_SRC=https://github.com/Church-of-the-LARP/UniversalTestingFramework.git#main

# --- Postgres ----------------------------------------------------------------

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-to-a-long-password
POSTGRES_DB=app
# The password is embedded in DATABASE_URL, so prefer URL-safe characters.

# --- Backend core ------------------------------------------------------------

# development | production. Production turns cookies Secure by default and
# falls back to resend for email unless EMAIL_PROVIDER is set. For a Launchpad
# deployment set this to production.
ENV=development

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-32-plus-character-secret
SESSION_TTL_HOURS=24
ACTION_TOKEN_TTL_HOURS=24

# Set true when the public origin is HTTPS. Empty lets ENV decide.
COOKIE_SECURE=false

# Local defaults. Behind Launchpad/Traefik/Cloudflare use the public origins:
#   PUBLIC_BASE_URL=https://api.example.com
#   FRONTEND_URL=https://app.example.com
#   CORS_ORIGINS=https://app.example.com
PUBLIC_BASE_URL=http://localhost:8888
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Bootstrap admin ---------------------------------------------------------
# Created on first boot with a verified email. The password is only used on
# creation; change it later through the admin UI.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# --- Google OAuth (optional) -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty derives PUBLIC_BASE_URL + /api/v1/auth/google/callback.
GOOGLE_REDIRECT_URL=

# --- Email -------------------------------------------------------------------
# mailpit captures messages locally; resend delivers them (RESEND_API_KEY required).
# For Launchpad production set EMAIL_PROVIDER=resend and fill RESEND_API_KEY.
EMAIL_PROVIDER=mailpit
EMAIL_FROM=QuitLARP <no-reply@example.com>
RESEND_API_KEY=
# Compose points the backend at its internal Mailpit; override only for external SMTP.
MAILPIT_SMTP_ADDR=mailpit:1025
MAILPIT_UI_URL=http://localhost:8025

# --- Storage -----------------------------------------------------------------
# Relative paths resolve against /app inside the backend container.
GIT_REPOS_DIR=data/git
DEPLOYMENTS_DIR=data/deployments

# --- Push validation ---------------------------------------------------------
# Appended with the spec path and run inside the pushed chapter. Empty disables
# the generation gate. The backend image ships `utf`, so invoke it directly.
VALIDATION_GENERATE_COMMAND=utf gen python
VALIDATION_GENERATE_TIMEOUT=5m

# --- Assessment sandbox ------------------------------------------------------
ASSESSMENT_SESSION_TTL=2h
ASSESSMENT_MEMORY_MB=512
ASSESSMENT_NANO_CPUS=1000000000
ASSESSMENT_PIDS_LIMIT=256
ASSESSMENT_BUILD_TIMEOUT=15m
ASSESSMENT_EXEC_TIMEOUT=90s
ASSESSMENT_DATA_DIR=data
ASSESSMENT_UTF_SRC_DIR=/utf-src
ASSESSMENT_HARNESS_IMAGE=codingtest-harness:latest
ASSESSMENT_IMAGE_PREFIX=codingtest-assessment

# --- Frontend ----------------------------------------------------------------
# Browser-visible API origin. For a Launchpad deployment this must be the public
# API URL, not localhost, or every fetch from the deployed SPA will fail.
VITE_API_URL=http://localhost:8888
